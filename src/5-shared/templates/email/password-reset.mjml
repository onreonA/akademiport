<mjml>
  <mj-head>
    <mj-title>Akademi Port - Şifre Sıfırlama</mj-title>
    <mj-preview>Şifre sıfırlama talebiniz alındı.</mj-preview>
  </mj-head>
  <mj-body>
    <mj-section background-color="#f4f4f4">
      <mj-column>
        <mj-image src="https://akademiport.com/logo.png" alt="Akademi Port" width="200px" />
        <mj-divider border-color="#2563eb" />
        <mj-text font-size="24px" color="#1f2937" font-weight="bold">
          Şifre Sıfırlama
        </mj-text>
        <mj-text font-size="16px" color="#4b5563">
          Merhaba {{user_name}},
        </mj-text>
        <mj-text font-size="16px" color="#4b5563">
          Şifre sıfırlama talebiniz alındı. Aşağıdaki butona tıklayarak yeni şifrenizi oluşturabilirsiniz.
        </mj-text>
        <mj-text font-size="14px" color="#ef4444">
          Bu link 1 saat geçerlidir.
        </mj-text>
        <mj-button href="{{reset_link}}" background-color="#2563eb" color="white">
          Şifre Sıfırla
        </mj-button>
        <mj-divider border-color="#e5e7eb" />
        <mj-text font-size="14px" color="#6b7280">
          Eğer bu talebi siz yapmadıysanız, bu email'i görmezden gelebilirsiniz.
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>

