    "test:build": "npm run build:ci",
    "test:all": "npm run test:run && npm run test:build && npm run test:e2e",
    "test:ci": "npm run type-check && npm run lint && npm run test:build && npm run test:run",
    "test:changed": "vitest run --changed",
    "prepare": "husky",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
