#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

echo "🔍 Running pre-commit checks..."

# Format check (değişiklik yapmadan)
echo "✨ Checking code format..."
npm run format:check || {
  echo "❌ Code format check failed. Run 'npm run format' to fix."
  exit 1
}

# Lint check
echo "🔍 Running linter..."
npm run lint || {
  echo "❌ Linting failed. Run 'npm run lint:fix' to auto-fix some issues."
  exit 1
}

# Type check
echo "📝 Type checking..."
npm run type-check || {
  echo "❌ Type check failed. Please fix TypeScript errors."
  exit 1
}

echo "✅ Pre-commit checks passed!"
