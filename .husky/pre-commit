#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

echo "🔍 Running pre-commit checks..."

# Format check (değişiklik yapmadan) - ZORUNLU
echo "✨ Checking code format..."
npm run format:check || {
  echo "❌ Code format check failed. Run 'npm run format' to fix."
  exit 1
}

# Lint check - OPSIYONEL (sadece uyarı ver, engelleme)
echo "🔍 Running linter (non-blocking)..."
npm run lint -- --quiet || {
  echo "⚠️  Linting found errors. Consider running 'npm run lint:fix'."
  echo "💡 Continuing with commit (lint check is non-blocking)..."
}

# Type check - OPSIYONEL (sadece uyarı ver, engelleme)
echo "📝 Type checking (non-blocking)..."
npm run type-check || {
  echo "⚠️  Type check found errors. Consider fixing TypeScript errors."
  echo "💡 Continuing with commit (type check is non-blocking)..."
}

echo "✅ Pre-commit checks passed!"
