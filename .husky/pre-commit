#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

echo "🔍 Running pre-commit checks..."

# Type check
echo "📝 Type checking..."
npm run type-check || {
  echo "❌ Type check failed. Please fix TypeScript errors."
  exit 1
}

# Build check (sadece import path'lerini kontrol etmek için)
echo "🏗️  Checking build..."
npm run build:ci || {
  echo "❌ Build failed. Please fix import path errors."
  exit 1
}

echo "✅ Pre-commit checks passed!"
